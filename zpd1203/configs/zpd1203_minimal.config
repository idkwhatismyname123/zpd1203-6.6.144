# ZPD1203 (MT6768) Linux 6.6 Minimal Bring-up Config Fragment
CONFIG_LOCALVERSION="-zpd1203-@idkwhatismyname123"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEVICE_MODULES_ALLOW_BUILTIN=y

# Cmdline & debugging (preserve LK ramoops.* & slot injection; remove ttynull)
CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected cgroup_disable=pressure cgroup.memory=nokmem"
CONFIG_CMDLINE_EXTEND=y
# CONFIG_CMDLINE_FORCE is not set

# Pstore / Ramoops (No-UART Level 1)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y

# Early SimpleFB & FBCon (No-UART Level 3)
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# CONFIG_DRM is not set
# CONFIG_DRM_MEDIATEK is not set
# CONFIG_DEVICE_MODULES_DRM_MEDIATEK is not set
# CONFIG_DRM_MEDIATEK_PANEL is not set
# CONFIG_DRM_MEDIATEK_V2 is not set

# Keep GKI_HIDDEN_SND_CONFIGS satisfied cleanly with zero audio drivers
CONFIG_SOUND=y
CONFIG_SND=y
# CONFIG_SND_USB_AUDIO is not set
# CONFIG_SND_SOC is not set
# CONFIG_DEVICE_MODULES_SND_SOC_MEDIATEK is not set
# CONFIG_SND_SOC_MT6768 is not set
# CONFIG_SND_SOC_MT6768_MT6358 is not set

# Trim non-MT6768 GKI bloat & heavy sanitizers to stay well below 32 MiB boot.img
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_UBSAN is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_KUNIT is not set
# CONFIG_PCI is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_SCSI is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_NVME_CORE is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_DWC3 is not set
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set
# CONFIG_WLAN is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_CORESIGHT is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_6LOWPAN is not set
# CONFIG_IEEE802154 is not set
# CONFIG_WWAN is not set

# Disable non-MT6768 device_modules and Phase 5+ subsystems
# CONFIG_COMMON_CLK_MT6991 is not set
# CONFIG_DEVAPC_MT6761 is not set
# CONFIG_DEVAPC_MT6765 is not set
# CONFIG_DEVAPC_MT6781 is not set
# CONFIG_MTK_IMGSENSOR_ISP4_T is not set
# CONFIG_MTK_CAM_CAL_ISP4_T is not set
# CONFIG_MTK_CAMERA_ISP_SUPPORT is not set
# CONFIG_MTK_CAMERA_ISP_RAW_SUPPORT_ISP4_T is not set
# CONFIG_MTK_CAMERA_DPE_ISP40 is not set
# CONFIG_MTK_CAMERA_FD_VERSION40 is not set
# CONFIG_MTK_V4L2_IMGSENSOR is not set
# CONFIG_MTK_V4L2_LENS is not set
# CONFIG_MTK_V4L2_FLASHLIGHT is not set
# CONFIG_MTK_LENS is not set
# CONFIG_MTK_FLASHLIGHT is not set
# CONFIG_MTK_JPEG is not set
# CONFIG_MTK_CCU is not set
# CONFIG_MTK_MDP is not set
# CONFIG_MTK_MMDVFS is not set
# CONFIG_DEVICE_MODULES_MTK_MMSYS is not set
# CONFIG_INTERCONNECT_MTK_MMQOS_MT6768 is not set
# CONFIG_INTERCONNECT_MTK_EXTENSION is not set
# CONFIG_CUSTOM_KERNEL_SENSORHUB_1_0 is not set
# CONFIG_NANOHUB is not set
# CONFIG_NANOHUB_MTK_IPI is not set
# CONFIG_MTK_SENSORHUB is not set
# CONFIG_MTK_SENSOR_SUPPORT is not set
# CONFIG_MTK_TINYSYS_SCP_SUPPORT is not set
# CONFIG_MTK_AEE_FEATURE is not set
# CONFIG_MTK_HANG_DETECT is not set
# CONFIG_TRUSTONIC_TEE_SUPPORT is not set
# CONFIG_MICROTRUST_TEE_SUPPORT is not set
# CONFIG_TEE is not set
# CONFIG_MTK_ENABLE_GENIEZONE is not set
# CONFIG_MTK_TRUSTED_MEMORY_SUBSYSTEM is not set
# CONFIG_MTK_GZVM is not set
# CONFIG_MTK_CHARGER is not set
# CONFIG_BATTERY_MT6358 is not set
# CONFIG_MTK_COMBO is not set
# CONFIG_MTK_BTIF is not set
# CONFIG_MTK_CONN_MD is not set
# CONFIG_MTK_ECCCI_DRIVER is not set
# CONFIG_MTK_GPU_MT6768_SUPPORT is not set
# CONFIG_MTK_GPU_SUPPORT is not set
# CONFIG_MTK_USB_TYPEC is not set
# CONFIG_TCPC_CLASS is not set
# CONFIG_USB_POWER_DELIVERY is not set
# CONFIG_EXTCON_MTK_USB is not set
# CONFIG_MTK_USB_META is not set
# CONFIG_MTK_USB_CONFIGFS_RNDIS is not set
# CONFIG_MTK_USB_BOOST is not set
# CONFIG_MTK_FPSGO_V3 is not set
# CONFIG_MTK_PERFORMANCE_MODULE is not set
# CONFIG_MTK_PERF_COMMON is not set
# CONFIG_MTK_SCHEDULER is not set
# CONFIG_MTK_CPUFREQ_SUGOV_EXT is not set
# CONFIG_MTK_CORE_CTL is not set
# CONFIG_MTK_CPUQOS_V3 is not set
# CONFIG_MTK_CROSS_SCHEDULER is not set
# CONFIG_MTK_QOS_FRAMEWORK is not set
# CONFIG_MTK_AMMS is not set
# CONFIG_MTK_MDDP_SUPPORT is not set
# CONFIG_MTK_PKVM_MKP is not set
# CONFIG_MTK_PKVM_MTK_SMC_HANDLER is not set
# CONFIG_MTK_PKVM_SMMU is not set
# CONFIG_MTK_MKP is not set
# CONFIG_MTK_WIDEVINE_DRM is not set

# Core MT6768 SoC, Clock, Pinctrl, PMIC, UART, WDT, DevAPC (builtin =y)
CONFIG_ARCH_MEDIATEK=y
CONFIG_MTK_PLATFORM="mt6768"
CONFIG_COMMON_CLK_MT6768=y
CONFIG_COMMON_CLK_PG_LEGACY=y
CONFIG_COMMON_CLK_MTK_FREQ_HOPPING=y
CONFIG_COMMON_CLK_MTK_FREQ_HOPPING_SSPM=y
CONFIG_MTK_CLKBUF_CTRL=y
CONFIG_MTK_PLAT_POWER_MT6768=y
CONFIG_DEVICE_MODULES_MTK_SCPSYS=y
CONFIG_DEVICE_MODULES_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_DEVICE_MODULES_MTK_TIMER=y
CONFIG_PINCTRL_MT6768=y
CONFIG_DEVICE_MODULES_PINCTRL_MTK_PARIS=y
CONFIG_DEVICE_MODULES_EINT_MTK=y
CONFIG_DEVICE_MODULES_MTK_PMIC_WRAP=y
# CONFIG_MTK_PMIC_WRAP is not set
CONFIG_DEVICE_MODULES_MFD_MT6397=y
# CONFIG_MFD_MT6397 is not set
CONFIG_DEVICE_MODULES_REGULATOR_MT6358=y
# CONFIG_REGULATOR_MT6358 is not set
CONFIG_DEVICE_MODULES_RTC_DRV_MT6397=y
# CONFIG_RTC_DRV_MT6397 is not set
CONFIG_MEDIATEK_MT635X_AUXADC=y
CONFIG_DEVICE_MODULES_MEDIATEK_MT6577_AUXADC=y
CONFIG_MTK_DEVINFO=y
CONFIG_MT635X_EFUSE=y
CONFIG_MTK_SOCINFO=y
CONFIG_MTK_EMI=y
CONFIG_MTK_EMI_LEGACY=y
CONFIG_MTK_DRAMC=y
CONFIG_MTK_IPI=y
CONFIG_MTK_MBOX=y
CONFIG_MTK_TINYSYS_SSPM_SUPPORT=y
CONFIG_DEVICE_MODULES_MEDIATEK_WATCHDOG=y
# CONFIG_MEDIATEK_WATCHDOG is not set
CONFIG_DEVAPC_MT6768=y
CONFIG_DEVICE_MODULES_SERIAL_8250_MT6577=y
# CONFIG_SERIAL_8250_MT6577 is not set
CONFIG_DEVICE_MODULES_MTK_CQDMA=y
CONFIG_DEVICE_MODULES_MTK_UART_APDMA=y

# Storage, eMMC, Inline Crypto, RPMB, Filesystems, DM-Verity
# CONFIG_DEVICE_MODULES_MMC_MTK is not set
CONFIG_DEVICE_MODULES_MMC_MTK_PRO=y
# CONFIG_MMC_MTK is not set
CONFIG_DEVICE_MODULES_MMC_CQHCI=y
# CONFIG_MMC_CQHCI is not set
CONFIG_DEVICE_MODULES_MMC_DEBUG=y
CONFIG_MTK_IRQ_DBG=y
# CONFIG_MTK_BLOCK_IO_TRACER is not set
CONFIG_MMC_BLOCK=y
CONFIG_MMC_CRYPTO=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_RPMB=y
CONFIG_RPMB_INTF_DEV=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# USB MUSB HDRC + TPHY + ConfigFS + FFS ADB
CONFIG_USB_MTK_HDRC=y
CONFIG_MTK_MUSB_QMU_SUPPORT=y
CONFIG_MTK_MUSB_QMU_PURE_ZLP_SUPPORT=y
CONFIG_MTK_MUSB_DRV_36BIT=y
CONFIG_USB_MTK_OTG=y
CONFIG_MTK_MUSB_DUAL_ROLE=y
# CONFIG_DEVICE_MODULES_USB_MTU3 is not set
# CONFIG_USB_MTU3 is not set
CONFIG_DEVICE_MODULES_PHY_MTK_TPHY=y
# CONFIG_PHY_MTK_TPHY is not set
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_ANDROID_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# IOMMU, SMI, Thermal, CPUFreq
CONFIG_DEVICE_MODULES_MTK_IOMMU=y
# CONFIG_MTK_IOMMU is not set
CONFIG_DEVICE_MODULES_MTK_SMI=y
# CONFIG_MTK_SMI is not set
CONFIG_MTK_SMI_BWC=y
# CONFIG_MTK_IOMMU_MISC is not set
CONFIG_DEVICE_MODULES_MTK_THERMAL=y
# CONFIG_MTK_THERMAL is not set
# CONFIG_MTK_LEGACY_THERMAL is not set
CONFIG_CPU_FREQ=y
# CONFIG_MEDIATEK_CPU_DVFS is not set
# CONFIG_MTK_DVFS_MT6768 is not set
# CONFIG_MTK_PPM_V3 is not set
# CONFIG_MTK_UNIFIED_POWER is not set
# CONFIG_MTK_PTPOD_LEGACY is not set
# CONFIG_MTK_STATIC_POWER_LEGACY is not set
# CONFIG_MEDIATEK_CPUIDLE is not set
# CONFIG_MEDIATEK_MCDI is not set
# CONFIG_MTK_SPM is not set

# Android BinderFS, DMA-BUF Heaps, SELinux, KernelSU
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_SYSFS_STATS=y
CONFIG_DMABUF_HEAPS_MTK_MM=y
CONFIG_DEVICE_MODULES_DMABUF_HEAPS_SYSTEM=y
CONFIG_DEVICE_MODULES_DMABUF_HEAPS_PAGE_POOL=y
CONFIG_DEVICE_MODULES_DMABUF_HEAPS_DEFERRED_FREE=y
# CONFIG_DMABUF_HEAPS_SYSTEM is not set
# CONFIG_DMABUF_HEAPS_DEFERRED_FREE is not set
# CONFIG_DMABUF_HEAPS_PAGE_POOL is not set
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_KSU=y
