# Promote DRM v2, GED & MMQoS vmlinux dependencies to built-in (=y)
CONFIG_MTK_MML=y
# CONFIG_MTK_MML_LEGACY is not set
CONFIG_MTK_THERMAL_INTERFACE=y
CONFIG_INTERCONNECT_MTK_EXTENSION=y
CONFIG_INTERCONNECT_MTK_MMQOS_COMMON=y
