# ZPD1203 Step 5A: Display, Backlight, Himax SPI Touch, and Mali GPU support

# Keep mainline MTK MMSYS/DRM/PWM/Regulators disabled; use MTK device_modules v2
# CONFIG_MTK_MMSYS is not set
# CONFIG_DRM_MEDIATEK is not set
# CONFIG_PWM_MTK_DISP is not set
# CONFIG_REGULATOR_MT6358 is not set
# CONFIG_MTK_CMDQ_MBOX is not set

# Core DRM / KMS / fbdev / Panel / Regulators / Backlight
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_DRM_LEGACY is not set
# CONFIG_FB_SIMPLE is not set
CONFIG_DEVICE_MODULES_MTK_MMSYS=y
CONFIG_DEVICE_MODULES_DRM_MEDIATEK=y
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_MTK_DISABLE_AEE_LAYER=y
# CONFIG_MTK_FB_MMDVFS_SUPPORT is not set
CONFIG_DRM_PANEL_HIMAX_JT120WUL005_VDO=y

CONFIG_MAILBOX=y
CONFIG_MTK_MBOX=y
CONFIG_MTK_CMDQ_MBOX_EXT=y
CONFIG_MTK_CMDQ_MBOX_EXT_MT6768=y

CONFIG_REGULATOR_AW37503=y
CONFIG_DEVICE_MODULES_I2C_MT65XX=y
CONFIG_DEVICE_MODULES_SPI_MT65XX=y
CONFIG_DEVICE_MODULES_PWM_MTK_DISP=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_MTK=y
CONFIG_LEDS_MTK_PWM=y
CONFIG_LEDS_MT_BRIGHTNESS_HW_CHANGED=y

# Himax HX83102-E/J SPI4 Touchscreen + built-in firmware
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_PROPERTIES=y
CONFIG_TOUCHSCREEN_HIMAX_CHIPSET=y
CONFIG_TOUCHSCREEN_HIMAX_COMMON=y
CONFIG_TOUCHSCREEN_HIMAX_INCELL=y
CONFIG_TOUCHSCREEN_HIMAX_IC_HX83102=y
CONFIG_TOUCHSCREEN_HIMAX_DEBUG=y
CONFIG_TOUCHSCREEN_HIMAX_INSPECT=y
CONFIG_TOUCHSCREEN_HIMAX_EMBEDDED_FIRMWARE=y
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="Himax_firmware.bin Himax_firmware_e.bin"
CONFIG_EXTRA_FIRMWARE_DIR="/home/asus/zpd1203-6.6/extracted_stock/firmware"

# Mali-G52 MC2 (out-of-tree mali_kbase.ko) platform dependencies
CONFIG_MTK_GPU_SUPPORT=y
CONFIG_MTK_GPUFREQ_V2=y
CONFIG_MTK_GPU_LEGACY=y
CONFIG_MTK_GPU_MT6768_SUPPORT=y
CONFIG_MTK_GPU_COMMON_DVFS_SUPPORT=y
CONFIG_MTK_GPU_SWPM_SUPPORT=y

# Disable unused non-MT6768 flash/PMIC drivers failing against slimmed Kconfig
