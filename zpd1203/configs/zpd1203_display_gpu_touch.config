# Built-in dependencies required by DRM v2, CMDQ, GED, and GPUFreq v2_legacy
CONFIG_MMPROFILE=y
CONFIG_MMEVENT=y
CONFIG_MTK_IOMMU_MISC=y
CONFIG_MTK_IOMMU_MISC_DBG=y
CONFIG_MTK_PBM=y
CONFIG_MTK_PEAK_POWER_BUDGET=y
