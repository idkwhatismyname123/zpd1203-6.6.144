From cc554201aaf598c35ebfb123dfe0d9354d1a169c Mon Sep 17 00:00:00 2001
From: ZPD1203 Kernel Port <zpd1203@localhost>
Date: Tue, 24 Nov 2026 18:27:15 +1000
Subject: [PATCH 1/5] kbuild: integrate device_modules Makefile.ext and
 KernelSU

---
 drivers/Kconfig  | 2 ++
 drivers/Makefile | 6 ++++++
 drivers/kernelsu | 1 +
 3 files changed, 9 insertions(+)
 create mode 120000 drivers/kernelsu

diff --git a/drivers/Kconfig b/drivers/Kconfig
index efb66e25f..a2874c223 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -243,4 +243,6 @@ source "drivers/hte/Kconfig"
 
 source "drivers/cdx/Kconfig"
 
+source "drivers/kernelsu/Kconfig"
+
 endmenu
diff --git a/drivers/Makefile b/drivers/Makefile
index 1bec7819a..2ec357cd8 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -199,3 +199,9 @@ obj-$(CONFIG_DRM_ACCEL)		+= accel/
 obj-$(CONFIG_CDX_BUS)		+= cdx/
 
 obj-$(CONFIG_S390)		+= s390/
+
+obj-$(CONFIG_KSU)		+= kernelsu/
+
+ifneq ($(KCONFIG_EXT_PREFIX),)
+include $(srctree)/$(KCONFIG_EXT_PREFIX)Makefile.ext
+endif
diff --git a/drivers/kernelsu b/drivers/kernelsu
new file mode 120000
index 000000000..2083957c4
--- /dev/null
+++ b/drivers/kernelsu
@@ -0,0 +1 @@
+../external/KernelSU/kernel
\ No newline at end of file
-- 
2.53.0

