From 398a4dd27ef0a5538a70281e112d2281db43a099 Mon Sep 17 00:00:00 2001
From: ZPD1203 Kernel Port <zpd1203@localhost>
Date: Wed, 25 Nov 2026 12:03:44 +1000
Subject: [PATCH] arm64: configs: add fbcon screen logs and USB ACM console
 fragment & update defconfig

---
 arch/arm64/configs/zpd1203_console_com.config | 16 ++++++++++++++++
 arch/arm64/configs/zpd1203_defconfig          |  7 ++++++-
 2 files changed, 22 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm64/configs/zpd1203_console_com.config

diff --git a/arch/arm64/configs/zpd1203_console_com.config b/arch/arm64/configs/zpd1203_console_com.config
new file mode 100644
index 0000000..5b7dd43
--- /dev/null
+++ b/arch/arm64/configs/zpd1203_console_com.config
@@ -0,0 +1,16 @@
+# ZPD1203 On-Screen Kernel Logs (fbcon) + USB ACM Serial Console
+CONFIG_DEVTMPFS=y
+# CONFIG_DEVTMPFS_MOUNT is not set
+CONFIG_VT=y
+CONFIG_CONSOLE_TRANSLATIONS=y
+CONFIG_VT_CONSOLE=y
+CONFIG_VT_CONSOLE_SLEEP=y
+CONFIG_HW_CONSOLE=y
+CONFIG_VT_HW_CONSOLE_BINDING=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
+CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
+CONFIG_FONTS=y
+CONFIG_FONT_8x16=y
+CONFIG_FONT_TER16x32=y
+CONFIG_U_SERIAL_CONSOLE=y
diff --git a/arch/arm64/configs/zpd1203_defconfig b/arch/arm64/configs/zpd1203_defconfig
index 68078a9..6c606fa 100644
--- a/arch/arm64/configs/zpd1203_defconfig
+++ b/arch/arm64/configs/zpd1203_defconfig
@@ -285,6 +285,7 @@ CONFIG_NL80211_TESTMODE=y
 CONFIG_CFG80211_WEXT=y
 CONFIG_RFKILL=m
 CONFIG_NET_9P=m
+CONFIG_DEVTMPFS=y
 CONFIG_EXTRA_FIRMWARE="Himax_firmware.bin Himax_firmware_e.bin"
 CONFIG_EXTRA_FIRMWARE_DIR="/home/asus/zpd1203-6.6/extracted_stock/firmware"
 CONFIG_FW_LOADER_USER_HELPER=y
@@ -352,7 +353,6 @@ CONFIG_JOYSTICK_XPAD=y
 CONFIG_INPUT_TOUCHSCREEN=y
 CONFIG_INPUT_MISC=y
 CONFIG_INPUT_UINPUT=y
-# CONFIG_VT is not set
 # CONFIG_LEGACY_PTYS is not set
 CONFIG_SERIAL_8250=y
 # CONFIG_SERIAL_8250_DEPRECATED_OPTIONS is not set
@@ -443,6 +443,7 @@ CONFIG_V4L_MEM2MEM_DRIVERS=y
 CONFIG_DRM=y
 CONFIG_FB=y
 CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
 CONFIG_SOUND=y
 CONFIG_SND=y
 CONFIG_SND_HRTIMER=y
@@ -486,6 +487,7 @@ CONFIG_USB_SERIAL=m
 CONFIG_USB_SERIAL_FTDI_SIO=m
 CONFIG_NOP_USB_XCEIV=y
 CONFIG_USB_GADGET=y
+CONFIG_U_SERIAL_CONSOLE=y
 CONFIG_USB_CONFIGFS=y
 CONFIG_ANDROID_USB_CONFIGFS_UEVENT=y
 CONFIG_USB_CONFIGFS_SERIAL=y
@@ -705,6 +707,9 @@ CONFIG_CRC8=y
 CONFIG_SWIOTLB_DYNAMIC=y
 CONFIG_DMA_RESTRICTED_POOL=y
 CONFIG_DMA_CMA=y
+CONFIG_FONTS=y
+CONFIG_FONT_8x16=y
+CONFIG_FONT_TER16x32=y
 CONFIG_PRINTK_TIME=y
 CONFIG_PRINTK_CALLER=y
 CONFIG_STACKTRACE_BUILD_ID=y
-- 
2.53.0

