From 79934f29bfe57bc141d1c18f6d4c8ca20b2ab723 Mon Sep 17 00:00:00 2001
From: ZPD1203 Kernel Port <zpd1203@localhost>
Date: Wed, 25 Nov 2026 12:03:44 +1000
Subject: [PATCH] arm64: configs: enable fbcon screen logs, TER16x32 font,
 devtmpfs and USB ACM console

---
 arch/arm64/configs/zpd1203_defconfig         | 7 ++++++-
 arch/arm64/configs/zpd1203_minimal_defconfig | 9 ++++++++-
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/configs/zpd1203_defconfig b/arch/arm64/configs/zpd1203_defconfig
index 68078a977..6c606fa33 100644
--- a/arch/arm64/configs/zpd1203_defconfig
+++ b/arch/arm64/configs/zpd1203_defconfig
@@ -285,6 +285,7 @@ CONFIG_NL80211_TESTMODE=y
 CONFIG_CFG80211_WEXT=y
 CONFIG_RFKILL=m
 CONFIG_NET_9P=m
+CONFIG_DEVTMPFS=y
 CONFIG_EXTRA_FIRMWARE="Himax_firmware.bin Himax_firmware_e.bin"
 CONFIG_EXTRA_FIRMWARE_DIR="/home/asus/zpd1203-6.6/extracted_stock/firmware"
 CONFIG_FW_LOADER_USER_HELPER=y
@@ -352,7 +353,6 @@ CONFIG_JOYSTICK_XPAD=y
 CONFIG_INPUT_TOUCHSCREEN=y
 CONFIG_INPUT_MISC=y
 CONFIG_INPUT_UINPUT=y
-# CONFIG_VT is not set
 # CONFIG_LEGACY_PTYS is not set
 CONFIG_SERIAL_8250=y
 # CONFIG_SERIAL_8250_DEPRECATED_OPTIONS is not set
@@ -443,6 +443,7 @@ CONFIG_V4L_MEM2MEM_DRIVERS=y
 CONFIG_DRM=y
 CONFIG_FB=y
 CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
 CONFIG_SOUND=y
 CONFIG_SND=y
 CONFIG_SND_HRTIMER=y
@@ -486,6 +487,7 @@ CONFIG_USB_SERIAL=m
 CONFIG_USB_SERIAL_FTDI_SIO=m
 CONFIG_NOP_USB_XCEIV=y
 CONFIG_USB_GADGET=y
+CONFIG_U_SERIAL_CONSOLE=y
 CONFIG_USB_CONFIGFS=y
 CONFIG_ANDROID_USB_CONFIGFS_UEVENT=y
 CONFIG_USB_CONFIGFS_SERIAL=y
@@ -705,6 +707,9 @@ CONFIG_CRC8=y
 CONFIG_SWIOTLB_DYNAMIC=y
 CONFIG_DMA_RESTRICTED_POOL=y
 CONFIG_DMA_CMA=y
+CONFIG_FONTS=y
+CONFIG_FONT_8x16=y
+CONFIG_FONT_TER16x32=y
 CONFIG_PRINTK_TIME=y
 CONFIG_PRINTK_CALLER=y
 CONFIG_STACKTRACE_BUILD_ID=y
diff --git a/arch/arm64/configs/zpd1203_minimal_defconfig b/arch/arm64/configs/zpd1203_minimal_defconfig
index f029af9d2..f55c0ca09 100644
--- a/arch/arm64/configs/zpd1203_minimal_defconfig
+++ b/arch/arm64/configs/zpd1203_minimal_defconfig
@@ -284,6 +284,7 @@ CONFIG_VIRTIO_VSOCKETS=m
 CONFIG_CGROUP_NET_PRIO=y
 CONFIG_RFKILL=m
 CONFIG_NET_9P=m
+CONFIG_DEVTMPFS=y
 CONFIG_FW_LOADER_USER_HELPER=y
 # CONFIG_FW_CACHE is not set
 CONFIG_CONNECTOR=y
@@ -349,7 +350,6 @@ CONFIG_JOYSTICK_XPAD=y
 CONFIG_INPUT_TOUCHSCREEN=y
 CONFIG_INPUT_MISC=y
 CONFIG_INPUT_UINPUT=y
-# CONFIG_VT is not set
 # CONFIG_LEGACY_PTYS is not set
 CONFIG_SERIAL_8250=y
 # CONFIG_SERIAL_8250_DEPRECATED_OPTIONS is not set
@@ -439,6 +439,9 @@ CONFIG_V4L_MEM2MEM_DRIVERS=y
 CONFIG_FB=y
 CONFIG_FB_SIMPLE=y
 CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
+CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
 CONFIG_SOUND=y
 CONFIG_SND=y
 CONFIG_SND_HRTIMER=y
@@ -482,6 +485,7 @@ CONFIG_USB_SERIAL=m
 CONFIG_USB_SERIAL_FTDI_SIO=m
 CONFIG_NOP_USB_XCEIV=y
 CONFIG_USB_GADGET=y
+CONFIG_U_SERIAL_CONSOLE=y
 CONFIG_USB_CONFIGFS=y
 CONFIG_ANDROID_USB_CONFIGFS_UEVENT=y
 CONFIG_USB_CONFIGFS_SERIAL=y
@@ -708,6 +712,9 @@ CONFIG_XZ_DEC=y
 CONFIG_SWIOTLB_DYNAMIC=y
 CONFIG_DMA_RESTRICTED_POOL=y
 CONFIG_DMA_CMA=y
+CONFIG_FONTS=y
+CONFIG_FONT_8x16=y
+CONFIG_FONT_TER16x32=y
 CONFIG_PRINTK_TIME=y
 CONFIG_PRINTK_CALLER=y
 CONFIG_STACKTRACE_BUILD_ID=y
-- 
2.53.0

