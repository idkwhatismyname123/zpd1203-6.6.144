From abae8068d6e7062dd86bbe3c28cea81e3f3a424a Mon Sep 17 00:00:00 2001
From: idkwhatismyname <107376203+idkwhatismyname123@users.noreply.github.com>
Date: Wed, 25 Nov 2026 14:20:00 +1000
Subject: [PATCH] arm64: configs: set ZPD1203 localversion to
 -zpd1203-@idkwhatismyname123

---
 arch/arm64/configs/zpd1203_defconfig         | 3 ++-
 arch/arm64/configs/zpd1203_minimal_defconfig | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/configs/zpd1203_defconfig b/arch/arm64/configs/zpd1203_defconfig
index bd29ecd36..3a2f282d0 100644
--- a/arch/arm64/configs/zpd1203_defconfig
+++ b/arch/arm64/configs/zpd1203_defconfig
@@ -1,5 +1,6 @@
 CONFIG_UAPI_HEADER_TEST=y
-CONFIG_LOCALVERSION="-zpd1203"
+CONFIG_LOCALVERSION="-zpd1203-@idkwhatismyname123"
+# CONFIG_LOCALVERSION_AUTO is not set
 CONFIG_AUDIT=y
 CONFIG_NO_HZ=y
 CONFIG_HIGH_RES_TIMERS=y
diff --git a/arch/arm64/configs/zpd1203_minimal_defconfig b/arch/arm64/configs/zpd1203_minimal_defconfig
index f55c0ca09..8a9e2cee9 100644
--- a/arch/arm64/configs/zpd1203_minimal_defconfig
+++ b/arch/arm64/configs/zpd1203_minimal_defconfig
@@ -1,5 +1,6 @@
 CONFIG_UAPI_HEADER_TEST=y
-CONFIG_LOCALVERSION="-zpd1203"
+CONFIG_LOCALVERSION="-zpd1203-@idkwhatismyname123"
+# CONFIG_LOCALVERSION_AUTO is not set
 CONFIG_AUDIT=y
 CONFIG_NO_HZ=y
 CONFIG_HIGH_RES_TIMERS=y
