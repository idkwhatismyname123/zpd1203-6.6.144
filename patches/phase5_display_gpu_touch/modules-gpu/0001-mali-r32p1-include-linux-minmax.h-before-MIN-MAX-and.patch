From 2d3b928b88ce4ea7c4211e76ebc5cf2c34746c4a Mon Sep 17 00:00:00 2001
From: ZPD1203 Kernel Port <zpd1203@localhost>
Date: Tue, 24 Nov 2026 20:53:31 +1000
Subject: [PATCH] mali-r32p1: include linux/minmax.h before MIN/MAX and fix OOT
 mt6768 Kbuild

---
 .../mali-r32p1/drivers/gpu/arm/midgard/mali_malisw.h       | 7 +++++++
 .../drivers/gpu/arm/midgard/platform/mt6768/Kbuild         | 2 +-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/gpu_mali/mali_valhall/mali-r32p1/drivers/gpu/arm/midgard/mali_malisw.h b/gpu_mali/mali_valhall/mali-r32p1/drivers/gpu/arm/midgard/mali_malisw.h
index e28d085..ccb7961 100644
--- a/gpu_mali/mali_valhall/mali-r32p1/drivers/gpu/arm/midgard/mali_malisw.h
+++ b/gpu_mali/mali_valhall/mali-r32p1/drivers/gpu/arm/midgard/mali_malisw.h
@@ -27,6 +27,9 @@
 #define _MALISW_H_
 
 #include <linux/version.h>
+#ifdef __KERNEL__
+#include <linux/minmax.h>
+#endif
 
 /**
  * MIN - Return the lesser of two values.
@@ -36,7 +39,9 @@
  * As a macro it may evaluate its arguments more than once.
  * Refer to MAX macro for more details
  */
+#ifndef MIN
 #define MIN(x, y)	((x) < (y) ? (x) : (y))
+#endif
 
 /**
  * MAX - Return the greater of two values.
@@ -50,7 +55,9 @@
  * to retrieve the min and max of two values, consider using a conditional swap
  * instead.
  */
+#ifndef MAX
 #define MAX(x, y)	((x) < (y) ? (y) : (x))
+#endif
 
 /**
  * Function-like macro for suppressing unused variable warnings.
diff --git a/gpu_mali/mali_valhall/mali-r32p1/drivers/gpu/arm/midgard/platform/mt6768/Kbuild b/gpu_mali/mali_valhall/mali-r32p1/drivers/gpu/arm/midgard/platform/mt6768/Kbuild
index 6a1186f..bffee8e 100644
--- a/gpu_mali/mali_valhall/mali-r32p1/drivers/gpu/arm/midgard/platform/mt6768/Kbuild
+++ b/gpu_mali/mali_valhall/mali-r32p1/drivers/gpu/arm/midgard/platform/mt6768/Kbuild
@@ -19,7 +19,7 @@
 #
 #
 
-include $(srctree)/$(src)/Kbuild-mtk-custom-env
+include $(M)/Kbuild-mtk-custom-env
 
 mali_kbase-y += \
 	platform/$(MALI_PLATFORM_DIR)/mali_kbase_config_mt6768.o
-- 
2.53.0

