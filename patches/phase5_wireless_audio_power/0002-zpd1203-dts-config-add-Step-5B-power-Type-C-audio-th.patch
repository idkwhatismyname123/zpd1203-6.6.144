From c168a2943f2c4665c8e38f10966160aa4920b4d7 Mon Sep 17 00:00:00 2001
From: ZPD1203 Kernel Port <zpd1203@localhost>
Date: Tue, 24 Nov 2026 21:14:32 +1000
Subject: [PATCH 2/2] zpd1203: dts/config: add Step 5B power, Type-C, audio,
 thermal and wireless support

---
 arch/arm64/boot/dts/mediatek/Makefile         |   1 +
 .../boot/dts/mediatek/mt6768-zpd1203.dts      | 107 +++++++++++++
 .../zpd1203-power-audio-wireless.dtsi         | 148 ++++++++++++++++++
 .../zpd1203_power_audio_wireless.config       |  63 ++++++++
 4 files changed, 319 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mediatek/mt6768-zpd1203.dts
 create mode 100644 arch/arm64/boot/dts/mediatek/zpd1203-power-audio-wireless.dtsi
 create mode 100644 arch/arm64/configs/zpd1203_power_audio_wireless.config

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index a5dd1da..988a216 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -51,3 +51,4 @@ dtb-$(CONFIG_ARCH_MEDIATEK) += mt8516-pumpkin.dtb
 
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6768-zpd1203-minimal.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6768-zpd1203-display.dtb
+dtb-$(CONFIG_ARCH_MEDIATEK) += mt6768-zpd1203.dtb
diff --git a/arch/arm64/boot/dts/mediatek/mt6768-zpd1203.dts b/arch/arm64/boot/dts/mediatek/mt6768-zpd1203.dts
new file mode 100644
index 0000000..dec1705
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6768-zpd1203.dts
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Master Linux 6.6 Device Tree for ZYB ZPD1203 (MT6769V/CB / MT6768)
+ * Full hardware bring-up: DRM v2 Display/Backlight, SPI4 Himax Touch,
+ * Mali-G52 GPU, SGM41510 Charger, AW35615 Type-C PD, MT6358 Fuel Gauge,
+ * MT6768/MT6358 Audio + AW87XXX SmartPA, and MT6768 Connsys Wi-Fi/BT.
+ */
+
+#include "mt6768.dts"
+#include "zpd1203-stock-battery-profile.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	model = "ZYB ZPD1203 (MT6769V/CB / k69v1_64 Linux 6.6)";
+	compatible = "mediatek,MT6768";
+
+	debug_kinfo: debug-kinfo {
+		compatible = "google,debug-kinfo";
+		status = "okay";
+	};
+
+	/* Stock dtbo_a overlay compatibility targets */
+	lcm: lcm { };
+	flashlights_aw36515: flashlights_aw36515 { };
+	hall: hall { };
+	hall_sensor: hall_sensor { };
+	battery_swell_det: battery_swell_det { };
+	zlt_alsps: zlt_alsps { };
+
+	framebuffer0: framebuffer@7d350000 {
+		compatible = "simple-framebuffer";
+		reg = <0x0 0x7d350000 0x0 0x0095a000>;
+		status = "disabled";
+	};
+};
+
+&chosen {
+	#address-cells = <2>;
+	#size-cells = <2>;
+	ranges;
+};
+
+&mmc0 {
+	status = "okay";
+};
+
+&mmc1 {
+	status = "disabled";
+};
+
+&consys {
+	vcn18-supply = <&mt_pmic_vcn18_ldo_reg>;
+	vcn28-supply = <&mt_pmic_vcn28_ldo_reg>;
+	vcn33_bt-supply = <&mt_pmic_vcn33_bt_ldo_reg>;
+	vcn33_wifi-supply = <&mt_pmic_vcn33_wifi_ldo_reg>;
+};
+
+&mt6370 {
+	status = "disabled";
+};
+
+&dvfsrc {
+	status = "disabled";
+};
+
+&sysirq {
+	mediatek,intpol-init = <0x00000000 0x00000000 0x00004a04 0x003ffffe
+				0xf01e6de0 0x00014e7b 0x80000808 0x1cedfff7
+				0x387ec02f 0x000000a0>;
+};
+
+&mt_pmic_vdram2_ldo_reg {
+	regulator-always-on;
+};
+
+&mt_pmic_vibr_ldo_reg {
+	regulator-min-microvolt = <1800000>;
+	regulator-max-microvolt = <1800000>;
+	regulator-always-on;
+};
+
+&regulator_vibrator {
+	status = "disabled";
+};
+
+&gpufreq {
+	vgpu-supply = <&mt_pmic_vgpu_buck_reg>;
+	vsram_gpu-supply = <&mt_pmic_vsram_gpu_ldo_reg>;
+};
+
+&mt6358regulator {
+	mt_pmic_vsim1_ldo_reg: ldo_vsim1 {
+		regulator-name = "vsim1";
+		regulator-min-microvolt = <1700000>;
+		regulator-max-microvolt = <3100000>;
+		regulator-enable-ramp-delay = <540>;
+	};
+	mt_pmic_vsim2_ldo_reg: ldo_vsim2 {
+		regulator-name = "vsim2";
+		regulator-min-microvolt = <1700000>;
+		regulator-max-microvolt = <3100000>;
+		regulator-enable-ramp-delay = <540>;
+	};
+};
+
+#include "zpd1203-display-touch-gpu.dtsi"
+#include "zpd1203-power-audio-wireless.dtsi"
diff --git a/arch/arm64/boot/dts/mediatek/zpd1203-power-audio-wireless.dtsi b/arch/arm64/boot/dts/mediatek/zpd1203-power-audio-wireless.dtsi
new file mode 100644
index 0000000..008bbaa
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/zpd1203-power-audio-wireless.dtsi
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ZPD1203 Step 5B Device Tree additions:
+ * - SGM41510 (BQ2589x register-compatible) charger on I2C5 @ 0x6b + OTG VBUS
+ * - AW35615 Type-C PD controller on I2C6 @ 0x22 + extcon_usb / mtk_ctd
+ * - MT6358 Fuel Gauge + mtk-master-charger + battery-manager
+ * - MT6768 ASoC + MT6358 Codec + ACCDET + AW87XXX SmartPA on I2C3 @ 0x59 / 0x5A
+ * - MT6768 Connsys Wi-Fi/BT regulators + antenna swap + BTIF
+ */
+
+&i2c3 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+	status = "okay";
+
+	aw87xxx_pa@59 {
+		compatible = "awinic,aw87xxx_pa";
+		reg = <0x59>;
+		dev_index = <0>;
+		status = "okay";
+	};
+
+	aw87xxx_pa@5A {
+		compatible = "awinic,aw87xxx_pa";
+		reg = <0x5a>;
+		dev_index = <1>;
+		status = "okay";
+	};
+};
+
+&i2c5 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+	status = "okay";
+
+	sgm41510: sgm41510@6b {
+		compatible = "sgm,sgm41510";
+		reg = <0x6b>;
+		status = "okay";
+		charger_name = "primary_chg";
+		charger = <&sgm41510>;
+		bootmode = <&chosen>;
+		sgm,irq-gpio = <&pio 26 0>;
+		sgm,chg-en-gpio = <&pio 166 0>;
+		sgm,charge-current = <2040000>;
+		sgm,battery-regulation-voltage = <4336000>;
+		sgm,termination-current = <192000>;
+		sgm,precharge-current = <128000>;
+		sgm,minimum-sys-voltage = <3500000>;
+		sgm,boost-voltage = <4998000>;
+		sgm,boost-max-current = <2400000>;
+		sgm,en-ilim = <1>;
+
+		sgm41510_vbus: usb_otg_vbus {
+			regulator-name = "usb_otg_vbus";
+			regulator-min-microvolt = <5000000>;
+			regulator-max-microvolt = <5150000>;
+		};
+	};
+};
+
+&i2c6 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+	status = "okay";
+
+	aw35615@22 {
+		compatible = "awinic,aw35615";
+		reg = <0x22>;
+		status = "okay";
+		awinic,int_n = <&pio 8 0>;
+		aw35615-id-gpio = <&pio 159 0>;
+		pd_stop_battery_soc = <80>;
+		aw35615,snk_pdo_size = <1>;
+		aw35615,snk_pdo_vol = <5000>;
+		aw35615,snk_pdo_cur = <2000>;
+		aw35615,src_pdo_size = <1>;
+		aw35615,src_pdo_vol = <5000>;
+		aw35615,src_pdo_cur = <2000>;
+	};
+};
+
+&mtk_gauge {
+	charger = <&sgm41510>;
+	status = "okay";
+};
+
+&battery_manager {
+	charger = <&sgm41510>;
+	gauge1 = <&mtk_gauge>;
+	status = "okay";
+};
+
+&charger {
+	charger = <&sgm41510>;
+	bootmode = <&chosen>;
+	enable_type_c;
+	power_path_support;
+	battery_cv = <4336000>;
+	max_charger_voltage = <10000000>;
+	min_charger_voltage = <4400000>;
+	usb_charger_current = <500000>;
+	ac_charger_current = <2000000>;
+	ac_charger_input_current = <2000000>;
+	status = "okay";
+};
+
+&mtk_ctd {
+	bc12-psy-port0 = <&sgm41510>;
+	status = "okay";
+};
+
+&extcon_usb {
+	charger = <&sgm41510>;
+	vbus-supply = <&sgm41510_vbus>;
+	id-gpios = <&pio 41 0>;
+	status = "okay";
+};
+
+&usb {
+	dr_mode = "otg";
+	status = "okay";
+};
+
+&sound {
+	compatible = "mediatek,mt6768-mt6358-sound";
+	mediatek,platform = <&afe>;
+	mediatek,audio-codec = <&mt6358codec>;
+	mtk_spk_i2s_out = <3>;
+	mtk_spk_i2s_in = <0>;
+	status = "okay";
+
+	mediatek,speaker-codec {
+		sound-dai = <&snd_scp_spk>;
+	};
+};
+
+&accdet {
+	status = "okay";
+};
+
+&consys {
+	wifi_ant_swap_gpio = <&pio 108 0>;
+	status = "okay";
+};
diff --git a/arch/arm64/configs/zpd1203_power_audio_wireless.config b/arch/arm64/configs/zpd1203_power_audio_wireless.config
new file mode 100644
index 0000000..0761c42
--- /dev/null
+++ b/arch/arm64/configs/zpd1203_power_audio_wireless.config
@@ -0,0 +1,63 @@
+# ZPD1203 Step 5B: Charger/Type-C/USB, Audio, Thermal/CPUFreq, and Connsys modules
+
+# Primary Charger (SGM41510 via bq2589x), MT6358 Gauge, AW35615 PD & Extcon USB
+CONFIG_POWER_SUPPLY=y
+CONFIG_MTK_CHARGER=y
+CONFIG_CHARGER_BQ2589X=y
+CONFIG_BATTERY_MT6358=y
+CONFIG_MTK_CHARGER_TYPE_DETECT=y
+CONFIG_AW_USBPD=y
+CONFIG_TCPC_CLASS=y
+CONFIG_USB_POWER_DELIVERY=y
+CONFIG_AW35615_PD=y
+# CONFIG_TCPC_MT6360 is not set
+# CONFIG_TCPC_MT6370 is not set
+# CONFIG_TCPC_MT6375 is not set
+# CONFIG_TCPC_MT6379 is not set
+# CONFIG_TCPC_RT1711H is not set
+# CONFIG_TCPC_RT1718S is not set
+CONFIG_EXTCON_MTK_USB=y
+# CONFIG_TYPEC_WUSB3801 is not set
+
+# Audio: MT6768 ASoC + MT6358 Codec + ACCDET + AW87XXX SmartPA + BTCVSD
+CONFIG_SND=y
+CONFIG_SND_SOC=y
+CONFIG_DEVICE_MODULES_SND_SOC_MEDIATEK=y
+CONFIG_SND_SOC_MT6768=y
+CONFIG_SND_SOC_MT6768_MT6358=y
+CONFIG_DEVICE_MODULES_SND_SOC_MT6358=y
+# CONFIG_SND_SOC_CODEC_MT6358 is not set
+CONFIG_SND_SOC_MT6358_ACCDET=y
+CONFIG_SND_SOC_AW87XXX=y
+CONFIG_DEVICE_MODULES_SND_SOC_MTK_BTCVSD=y
+
+# Thermal, CPUFreq DVFS/PPM/EEM (MT6768)
+CONFIG_MTK_LEGACY_THERMAL=y
+CONFIG_MTK_LEGACY_THERMAL_PLATFORM="mt6768"
+CONFIG_MEDIATEK_CPU_DVFS=y
+CONFIG_MTK_DVFS_MT6768=y
+CONFIG_MTK_PPM_V3=y
+CONFIG_MTK_PTPOD_LEGACY=y
+# CONFIG_DEVICE_MODULES_ARM_MEDIATEK_CPUFREQ_HW is not set
+
+# Connectivity In-Tree Support (modular for OOT Motorola 6.6 Connsys stack)
+CONFIG_CFG80211=m
+CONFIG_NL80211_TESTMODE=y
+CONFIG_CFG80211_WEXT=y
+CONFIG_MTK_BTIF=m
+CONFIG_MTK_CONN_MD=m
+CONFIG_MTK_COMBO=m
+CONFIG_MTK_COMBO_CHIP_CONSYS_6768=y
+# CONFIG_MTK_COMBO_CHIP_CONSYS_6985 is not set
+# CONFIG_MTK_COMBO_CHIP_CONSYS_6989 is not set
+# CONFIG_MTK_COMBO_CHIP_CONSYS_6991 is not set
+# CONFIG_MTK_COMBO_CHIP_CONSYS_6899 is not set
+# Promote Step 5B vmlinux platform dependencies to built-in (=y)
+CONFIG_MTK_SPM=y
+CONFIG_MEDIATEK_MCDI=y
+CONFIG_MTK_CPUHOTPLUG=y
+CONFIG_MTK_UNIFIED_POWER=y
+CONFIG_MTK_COMBO=y
+# CONFIG_MTK_THERMAL_PA_VIA_ATCMD is not set
+CONFIG_MEDIATEK_CPUIDLE=y
+CONFIG_MTK_POWER_GS_LEGACY=y
-- 
